<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Top decorative circle -->
    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-190dp"
        android:layout_marginTop="-180dp"
        android:background="@drawable/splash_circle_top" />

    <!-- Bottom decorative circle -->
    <View
        android:layout_width="330dp"
        android:layout_height="330dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-190dp"
        android:layout_marginBottom="-190dp"
        android:background="@drawable/splash_circle_bottom" />

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="230dp"
            android:layout_height="210dp"
            android:contentDescription="TickTask Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <!-- App Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task"
                android:textColor="@color/splash_white"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tick"
                android:fontFamily=""
                android:textColor="@color/splash_lavender"
                android:textSize="46sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="هر روز، یک قدم به جلو 💜"
            android:textColor="#EBD9FF"
            android:textSize="17sp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="5dp"
            android:layout_marginTop="100dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/splash_lavender"
            android:progressTint="@color/splash_lavender"
            android:progressBackgroundTint="@color/splash_progress_track" />

    </LinearLayout>

</FrameLayout>
